    { "key": "sew_hide_clothing", "name": "Sew Hide Clothing", "inputs": { "hides": "2" },              "outputs": { "hide_clothing": "1" }, "workers": 1, "years": 1 },
    { "key": "fire_pottery",      "name": "Fire Pottery",      "inputs": { "clay": "2", "wood": "1" },  "outputs": { "pottery": "1" },       "workers": 1, "years": 1 },
    { "key": "weave_wool",        "name": "Weave Wool",        "inputs": { "wool": "2" },               "outputs": { "cloth": "1" },         "workers": 1, "years": 1 },
    { "key": "weave_flax",        "name": "Weave Flax",        "inputs": { "flax": "3" },               "outputs": { "cloth": "1" },         "workers": 1, "years": 1 },
    { "key": "bake_bread",        "name": "Bake Bread",        "inputs": { "grain": "2", "wood": "1" }, "outputs": { "bread": "2" },         "workers": 1, "years": 1 }
