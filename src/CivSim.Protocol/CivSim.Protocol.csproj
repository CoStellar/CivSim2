<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The simulation is always compiled with optimizations: the Godot editor runs the Debug build, and an unoptimized core made turns about 10 times slower. -->
    <Optimize>true</Optimize>
    <RootNamespace>CivSim.Protocol</RootNamespace>
  </PropertyGroup>
  <!-- No reference to CivSim.Core: the Godot client sees only this assembly, so its public types must not expose Core. -->
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.12" />
  </ItemGroup>
</Project>
