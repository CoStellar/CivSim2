<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the legacy game's systems (ADR 0028: legacy, not developed further). Split from CivSim.Tests on 2026-11-22
       so that the new game's quick loop is CivSim.Sim.Tests + CivSim.Tests; `dotnet test` still runs these too. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>CivSim.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\CivSim.Tests\TestContent.cs" Link="TestContent.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CivSim.Core\CivSim.Core.csproj" />
    <ProjectReference Include="..\..\src\CivSim.Data\CivSim.Data.csproj" />
    <ProjectReference Include="..\..\src\CivSim.Protocol\CivSim.Protocol.csproj" />
    <ProjectReference Include="..\..\src\CivSim.Server\CivSim.Server.csproj" />
    <ProjectReference Include="..\..\src\CivSim.Headless\CivSim.Headless.csproj" />
  </ItemGroup>
</Project>
